+    def test_publication_lock_never_creates_a_dangling_link_target(self):
+        import perpetual_engine.chronos as chronos_module
+
+        self.output_root.mkdir(parents=True)
+        external_parent = self.root / "external-lock-parent"
+        external_parent.mkdir()
+        external = external_parent / "must-not-be-created"
+        self._symlink(self.output_root / ".publication.lock", external)
+        patches = self._patch_inputs()
+        try:
+            with patches[0], patches[1], patches[2], patches[3], patches[4]:
+                with self.assertRaisesRegex(ValueError, "lock.*(link|escapes|direct child)"):
+                    chronos_module.publish_forecast(
+                        self.config.path,
+                        self.output_root,
+                        predictor=self.fake_predictor,
+                        issued_at=datetime(2024, 2, 1, tzinfo=timezone.utc),
+                    )
+        finally:
+            self.assertFalse(external.exists())
+
+    def test_publication_lock_install_loses_safely_to_a_competing_link(self):
+        import perpetual_engine.chronos as chronos_module
+
+        self.output_root.mkdir(parents=True)
+        lock_path = self.output_root / ".publication.lock"
+        external = self.root / "race-target-must-not-be-created"
+        real_link = os.link
+
+        def install_competing_link(source, destination, *args, **kwargs):
+            Path(destination).symlink_to(external)
+            return real_link(source, destination, *args, **kwargs)
+
+        patches = self._patch_inputs()
+        try:
+            with patches[0], patches[1], patches[2], patches[3], patches[4], patch(
+                "perpetual_engine.chronos.os.link", side_effect=install_competing_link
+            ):
+                with self.assertRaisesRegex(ValueError, "lock.*(link|escapes|direct child)"):
+                    chronos_module.publish_forecast(
+                        self.config.path,
+                        self.output_root,
+                        predictor=self.fake_predictor,
+                        issued_at=datetime(2024, 2, 1, tzinfo=timezone.utc),
+                    )
+        finally:
+            self.assertTrue(lock_path.is_symlink())
