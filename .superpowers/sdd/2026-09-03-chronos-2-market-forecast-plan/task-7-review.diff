+class ChronosCliTests(unittest.TestCase):
+    def test_chronos_commands_dispatch_exact_paths_without_legacy_handlers(self):
+        from perpetual_engine.cli import main
+
+        cases = (
+            (
+                ["chronos", "refresh", "--config", "config.json"],
+                "perpetual_engine.chronos_data.refresh_chronos_data",
+                (Path("config.json"),),
+                "vintage-id",
+            ),
+            (
+                ["chronos", "forecast", "--config", "config.json", "--output", "out"],
+                "perpetual_engine.chronos.publish_forecast",
+                (Path("config.json"), Path("out")),
+                "forecast-id",
+            ),
+            (
+                ["chronos", "evaluate", "--config", "config.json", "--output", "out"],
+                "perpetual_engine.chronos.evaluate_chronos",
+                (Path("config.json"), Path("out")),
+                Path("out/evaluation-id"),
+            ),
+            (
+                [
+                    "chronos", "reconcile", "--config", "config.json",
+                    "--forecast-root", "forecasts", "--output", "out",
+                ],
+                "perpetual_engine.chronos.reconcile_forecasts",
+                (Path("config.json"), Path("forecasts"), Path("out")),
+                "monitoring-id",
+            ),
+        )
+        for argv, target, expected_args, returned in cases:
+            with self.subTest(command=argv[1]), patch(target, return_value=returned) as selected, patch(
+                "perpetual_engine.cli.evaluate_command"
+            ) as legacy_evaluate, patch(
+                "perpetual_engine.backtest_report.refresh_data"
+            ) as legacy_refresh, patch(
+                "perpetual_engine.backtest_report.run_backtest_report"
+            ) as legacy_backtest, patch("sys.stdout", new=io.StringIO()) as stdout, patch(
+                "sys.stderr", new=io.StringIO()
+            ) as stderr:
+                self.assertEqual(main(argv), 0)
+                selected.assert_called_once_with(*expected_args)
+                self.assertEqual(stdout.getvalue(), f"{returned}\n")
+                self.assertEqual(stderr.getvalue(), "")
+                legacy_evaluate.assert_not_called()
+                legacy_refresh.assert_not_called()
+                legacy_backtest.assert_not_called()
+
+    def test_chronos_corrupt_archive_is_an_input_error_with_all_paths(self):
+        from perpetual_engine.cli import main
+
+        argv = [
+            "chronos", "reconcile", "--config", "bad.json",
+            "--forecast-root", "broken-archive", "--output", "out",
+        ]
+        with patch(
+            "perpetual_engine.chronos.reconcile_forecasts", side_effect=ValueError("corrupt archive")
+        ), patch("sys.stdout", new=io.StringIO()) as stdout, patch(
+            "sys.stderr", new=io.StringIO()
+        ) as stderr:
+            self.assertEqual(main(argv), 2)
+        message = stderr.getvalue()
+        self.assertEqual(stdout.getvalue(), "")
+        self.assertIn("Input error", message)
+        self.assertIn("bad.json", message)
+        self.assertIn("broken-archive", message)
+        self.assertIn("out", message)
+        self.assertNotIn("Traceback", message)
