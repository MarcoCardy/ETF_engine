+class ChronosForecastTests(unittest.TestCase):
+    TARGETS = ("WORLD", "MOMENTUM", "QUALITY", "TREND")
+    COVARIATES = ("ECB_DFR", "US_TREASURY_10Y", "BRENT_RETURN", "BIS_USD_CREDIT_YOY", "US_CPI_YOY")
+
+    @staticmethod
